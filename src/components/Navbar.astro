---
interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
const isActive = (path: string) => currentPath.includes(path);
---

<header class="sticky top-0 z-50 bg-[#F8F6F0]/95 backdrop-blur-md border-b border-vela-linea vela-site-header">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-3 -translate-y-[3px] shrink-0 transition-transform">
      <img src="/assets/vela-logo.png" alt="VELA" class="h-8 sm:h-9 w-auto" />
    </a>

    <nav class="hidden lg:flex items-center gap-6 xl:gap-8 text-sm font-medium text-vela-chocolate/80" aria-label="Navegación principal">
      <a href="/la-biografia" class={`vela-nav-link ${isActive('la-biografia') ? 'text-vela-chocolate font-semibold is-active' : ''}`}>La biografía</a>
      <a href="/como-funciona" class={`vela-nav-link ${isActive('como-funciona') ? 'text-vela-chocolate font-semibold is-active' : ''}`}>Cómo funciona</a>
      <a href="/ejemplos" class={`vela-nav-link ${isActive('ejemplos') ? 'text-vela-chocolate font-semibold is-active' : ''}`}>Ejemplos</a>
      <a href="/precios" class={`vela-nav-link ${isActive('precios') ? 'text-vela-chocolate font-semibold is-active' : ''}`}>Precios</a>
      <a href="/nosotros" class={`vela-nav-link ${isActive('nosotros') ? 'text-vela-chocolate font-semibold is-active' : ''}`}>Nosotros</a>
    </nav>

    <div class="hidden lg:flex items-center gap-4 xl:gap-5 shrink-0">
      <!-- Selector de Idiomas Dropdown (Fiel a la captura de referencia) -->
      <div class="relative vela-lang-dropdown select-none" id="vela-lang-dropdown">
        <button
          type="button"
          class="vela-lang-trigger flex items-center justify-center border border-[#7A6C58]/40 bg-transparent text-vela-chocolate px-3.5 py-1.5 text-xs font-serif font-medium hover:border-vela-chocolate transition-colors rounded-[2px] cursor-pointer min-w-[46px] shadow-sm"
          id="vela-lang-trigger"
          aria-expanded="false"
          aria-haspopup="true"
        >
          <span id="current-lang-label" class="pointer-events-none">ES</span>
        </button>

        <div
          id="vela-lang-menu"
          class="hidden absolute right-0 top-full mt-1.5 w-48 bg-[#FAF7F2] border border-[#7A6C58]/25 shadow-[0_14px_32px_-4px_rgba(44,42,40,0.18)] z-[9999] py-1 rounded-[2px] transition-all"
          role="menu"
        >
          <button
            type="button"
            class="w-full flex items-center justify-between px-4 py-2.5 text-xs font-serif text-left hover:bg-[#EFE8DC] text-vela-chocolate transition-colors vela-lang-item is-active cursor-pointer"
            data-lang="ES"
            role="menuitem"
          >
            <span class="font-medium text-[#682D35]">Español</span>
            <span class="text-[11px] tracking-wider text-vela-topo uppercase font-sans">ES</span>
          </button>
          <button
            type="button"
            class="w-full flex items-center justify-between px-4 py-2.5 text-xs font-serif text-left hover:bg-[#EFE8DC] text-vela-chocolate/85 hover:text-vela-chocolate transition-colors vela-lang-item cursor-pointer"
            data-lang="EN"
            role="menuitem"
          >
            <span class="font-normal text-vela-chocolate">English</span>
            <span class="text-[11px] tracking-wider text-vela-topo uppercase font-sans">EN</span>
          </button>
          <button
            type="button"
            class="w-full flex items-center justify-between px-4 py-2.5 text-xs font-serif text-left hover:bg-[#EFE8DC] text-vela-chocolate/85 hover:text-vela-chocolate transition-colors vela-lang-item cursor-pointer"
            data-lang="FR"
            role="menuitem"
          >
            <span class="font-normal text-vela-chocolate">Français</span>
            <span class="text-[11px] tracking-wider text-vela-topo uppercase font-sans">FR</span>
          </button>
        </div>
      </div>

      <a href="/precios" class="vela-btn-header-cta px-5 py-2.5 bg-[#1E1B18] text-[#F8F6F0] border border-[#1E1B18] text-sm font-medium rounded-sm transition-all shadow-sm">Crear biografía</a>
    </div>

    <button id="menu-btn" class="lg:hidden text-vela-chocolate p-2 min-h-11 min-w-11" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path></svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-vela-linea bg-[#F8F6F0] px-6 py-6 space-y-2">
    <a href="/la-biografia" class="block py-2.5 text-base font-medium text-vela-chocolate/80">La biografía</a>
    <a href="/como-funciona" class="block py-2.5 text-base font-medium text-vela-chocolate/80">Cómo funciona</a>
    <a href="/ejemplos" class="block py-2.5 text-base font-medium text-vela-chocolate/80">Ejemplos</a>
    <a href="/precios" class="block py-2.5 text-base font-medium text-vela-chocolate/80">Precios</a>
    <a href="/nosotros" class="block py-2.5 text-base font-medium text-vela-chocolate/80">Nosotros</a>
    <div class="py-3 border-t border-vela-linea flex items-center justify-between">
      <span class="text-xs font-medium text-vela-chocolate/70 uppercase tracking-wider">Idioma</span>
      <div class="inline-flex rounded border border-vela-linea p-0.5 bg-white/70">
        <button type="button" class="px-2.5 py-1 text-xs font-semibold rounded-sm bg-vela-chocolate text-white cursor-pointer" data-mobile-lang="ES">ES</button>
        <button type="button" class="px-2.5 py-1 text-xs font-semibold rounded-sm text-vela-chocolate/75 cursor-pointer" data-mobile-lang="EN">EN</button>
        <button type="button" class="px-2.5 py-1 text-xs font-semibold rounded-sm text-vela-chocolate/75 cursor-pointer" data-mobile-lang="FR">FR</button>
      </div>
    </div>
    <div class="pt-2 border-t border-vela-linea space-y-3">
      <a href="/precios" class="block w-full text-center py-3.5 bg-[#1E1B18] text-white border border-[#1E1B18] text-sm font-medium rounded-sm shadow-sm min-h-[48px] flex items-center justify-center">Crear biografía</a>
    </div>
  </div>
</header>

<script is:inline>
  (function initNavbarLanguageDropdown() {
    function setup() {
      const trigger = document.getElementById('vela-lang-trigger');
      const menu = document.getElementById('vela-lang-menu');
      const dropdown = document.getElementById('vela-lang-dropdown');
      if (!trigger || !menu) return;

      function toggle(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        const isHidden = menu.classList.contains('hidden');
        if (isHidden) {
          menu.classList.remove('hidden');
          trigger.setAttribute('aria-expanded', 'true');
        } else {
          menu.classList.add('hidden');
          trigger.setAttribute('aria-expanded', 'false');
        }
      }

      // Soporte completo para click y puntero
      trigger.onclick = toggle;

      // Cerrar al hacer clic en un elemento del menú
      menu.querySelectorAll('.vela-lang-item').forEach(function(item) {
        item.addEventListener('click', function() {
          menu.classList.add('hidden');
          trigger.setAttribute('aria-expanded', 'false');
        });
      });

      // Cerrar al pulsar fuera
      document.addEventListener('click', function(e) {
        if (dropdown && !dropdown.contains(e.target)) {
          menu.classList.add('hidden');
          trigger.setAttribute('aria-expanded', 'false');
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setup);
    } else {
      setup();
    }
  })();
</script>
