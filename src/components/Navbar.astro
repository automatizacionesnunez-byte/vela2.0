---
interface Props {
  currentPath?: string;
}

const { currentPath = "" } = Astro.props;
---

<header class="sticky top-0 z-50 bg-[#F8F6F0]/95 backdrop-blur-md border-b border-vela-linea vela-site-header">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3">
      <img src="/assets/vela-logo.png" alt="VELA" class="h-8 sm:h-9 w-auto" />
    </a>

    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-vela-chocolate/80">
      <a href="/la-biografia" class={`hover:text-vela-chocolate transition-colors ${currentPath.includes('la-biografia') ? 'text-vela-chocolate font-semibold' : ''}`}>La biografía</a>
      <a href="/como-funciona" class={`hover:text-vela-chocolate transition-colors ${currentPath.includes('como-funciona') ? 'text-vela-chocolate font-semibold' : ''}`}>Cómo funciona</a>
      <a href="/precios" class={`hover:text-vela-chocolate transition-colors ${currentPath.includes('precios') ? 'text-vela-chocolate font-semibold' : ''}`}>Precios</a>
      <a href="/nosotros" class={`hover:text-vela-chocolate transition-colors ${currentPath.includes('nosotros') ? 'text-vela-chocolate font-semibold' : ''}`}>Nosotros</a>
    </nav>

    <div class="hidden md:flex items-center gap-5">
      <a href="/login" class="text-sm font-medium text-vela-chocolate/80 hover:text-vela-chocolate transition-colors">Iniciar sesión</a>
      <a href="/precios" class="px-5 py-2.5 bg-vela-chocolate text-white text-sm font-medium rounded-sm hover:bg-black transition-colors shadow-sm">Crear biografía</a>
    </div>

    <button id="menu-btn" class="md:hidden text-vela-chocolate p-2" aria-label="Abrir menú" aria-expanded="false">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>

  <!-- Menú móvil -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-vela-linea bg-[#F8F6F0] px-6 py-6 space-y-4">
    <a href="/la-biografia" class="block text-base font-medium text-vela-chocolate">La biografía</a>
    <a href="/como-funciona" class="block text-base font-medium text-vela-chocolate">Cómo funciona</a>
    <a href="/precios" class="block text-base font-medium text-vela-chocolate">Precios</a>
    <a href="/nosotros" class="block text-base font-medium text-vela-chocolate">Nosotros</a>
    <div class="pt-4 border-t border-vela-linea space-y-3">
      <a href="/login" class="block text-sm font-medium text-vela-chocolate">Iniciar sesión</a>
      <a href="/precios" class="block w-full text-center py-3 bg-vela-chocolate text-white text-sm font-medium rounded-sm">Crear biografía</a>
    </div>
  </div>
</header>
