---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="La biografía | VELA"
  description="Convertimos la vida de tus seres queridos en un libro editorial único."
  bodyClass="bg-[#F8F6F0] text-[#26231F] font-sans antialiased selection:bg-vela-burdeos selection:text-white vela-page-la-biografia"
>
<main>
    <!-- SECCIÓN 1: PRESENTACIÓN DEL PRODUCTO REPLICADA EN HTML/CSS -->
    <section class="py-16 lg:py-24 bg-[#F8F6F0] border-b border-vela-linea">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">

          <!-- Izquierda: Escena editorial cálida de estudio (estilo mesa de madera con luz natural) -->
          <div class="lg:col-span-6">
            <div class="vela-bio-stage">
              <!-- Controles de modelos y vista del sobre -->
              <div class="vela-stage-controls">
                <div class="vela-stage-models" role="tablist" aria-label="Elegir modelo de biografía">
                  <button type="button" class="vela-stage-model-btn is-active" data-stage-model="letter" role="tab" aria-selected="true">
                    Letter · Carmen
                  </button>
                  <button type="button" class="vela-stage-model-btn" data-stage-model="noir" role="tab" aria-selected="false">
                    Noir · Juan
                  </button>
                  <button type="button" class="vela-stage-model-btn" data-stage-model="nude" role="tab" aria-selected="false">
                    Nude · Carlota
                  </button>
                </div>

                <button type="button" class="vela-stage-view-toggle" id="velaStageEnvelopeToggle" title="Alternar entre sobre cerrado con lacre y dedicatoria abierta">
                  <span id="velaStageEnvelopeLabel">Ver sobre abierto</span>
                  <svg class="w-3.5 h-3.5 text-vela-topo" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3"/></svg>
                </button>
              </div>

              <!-- Composición cálida sobre mesa de madera de estudio -->
              <div class="vela-bio-stage__composition">
                <!-- Mini polaroids antiguas de recuerdo en la mesa -->
                <div class="vela-stage-polaroid vela-stage-polaroid--1" aria-hidden="true">
                  <img src="/assets/carmen-hero-1600.webp" alt="" />
                </div>
                <div class="vela-stage-polaroid vela-stage-polaroid--2" aria-hidden="true">
                  <img src="/assets/carmen-family-1200.webp" alt="" />
                </div>

                <!-- iPad inclinado con pliego editorial real, dinámico y 100% legible -->
                <div class="vela-css-ipad">
                  <div class="vela-css-ipad__screen" id="stageIpadScreen">
                    <span class="vela-css-ipad__num" id="stageIpadNum">01</span>
                    <h2 class="vela-css-ipad__chapter" id="stageIpadChapter">Orígenes</h2>
                    <p class="vela-css-ipad__subtitle" id="stageIpadSubtitle">Una vida llena de pequeñas grandes historias</p>
                    <div class="vela-css-ipad__copy" id="stageIpadCopy">
                      <p id="stageIpadP1">Carmen nació en un barrio de artesanos y recuerdos de infancia junto al mar. De su madre aprendió el valor de la constancia y de su padre la pasión por la música y las tertulias familiares.</p>
                      <p id="stageIpadP2">Su historia avanza como una carta íntima escrita a mano, donde cada fotografía y cada anécdota conservan el perfume y la calidez del hogar.</p>
                    </div>
                    <div class="vela-css-ipad__footer" id="stageIpadFooter">— Memoria familiar VELA · Modelo Letter —</div>
                  </div>
                </div>

                <!-- Portada física impresa del modelo seleccionado (apoyada abajo a la izquierda sin tapar texto) -->
                <div class="vela-css-booklet" aria-label="Portada editorial del modelo">
                  <img id="stageBookletImg" src="/assets/templates/letter_page_01.jpg" alt="Portada del modelo Letter de Carmen Rodríguez Sánchez" class="transition-opacity duration-200" />
                </div>

                <!-- Fotografía real del Sobre con Lacre y tarjeta QR física (apoyada abajo a la derecha) -->
                <div class="vela-real-envelope-set" id="velaRealEnvelopeContainer" title="Haz clic para alternar entre sobre cerrado con lacre y dedicatoria abierta" aria-label="Sobre VELA real en papel verjurado con sello de lacre rojo y tarjeta física con QR">
                  <img id="velaRealEnvelopeImg" src="/assets/sobre-lacre-cerrado-transparente.webp" alt="Sobre VELA cerrado con sello de lacre rojo burdeos y tarjeta con código QR" class="transition-opacity duration-200" />
                </div>
              </div>
              <p class="vela-bio-stage__caption">Biografía digital en pantalla &nbsp;+&nbsp; libro impreso de recuerdo &nbsp;+&nbsp; sobre físico con lacre</p>
            </div>
          </div>

          <!-- Derecha: Titular limpio + 3 Filas con iconos y líneas divisorias -->
          <div class="lg:col-span-6 space-y-6">
            <h1 class="font-serif text-4xl sm:text-5xl lg:text-6xl font-normal text-vela-chocolate leading-[1.06]">
              Una historia única,<br/>
              <span class="italic text-vela-topo">en digital y para regalar.</span>
            </h1>
            <p class="text-base sm:text-lg text-vela-chocolate/80 font-light leading-relaxed max-w-xl">
              VELA transforma recuerdos, fotografías y testimonios en una biografía digital personalizada, cuidada y lista para leer en cualquier dispositivo.
            </p>

            <div class="vela-icon-rows pt-2">
              <div class="vela-icon-row">
                <div class="vela-icon-row__circle" aria-hidden="true">
                  <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                </div>
                <div class="vela-icon-row__divider" aria-hidden="true"></div>
                <div class="vela-icon-row__content">
                  <h3>¿Qué es?</h3>
                  <p>Una biografía digital personalizada sobre ti o sobre alguien querido, redactada y organizada por capítulos.</p>
                </div>
              </div>

              <div class="vela-icon-row">
                <div class="vela-icon-row__circle" aria-hidden="true">
                  <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <div class="vela-icon-row__divider" aria-hidden="true"></div>
                <div class="vela-icon-row__content">
                  <h3>¿Qué incluye?</h3>
                  <p>Maquetación editorial, acceso digital en tablet, móvil y ordenador, descarga en PDF y entrega física con sobre VELA y tarjeta QR.</p>
                </div>
              </div>

              <div class="vela-icon-row">
                <div class="vela-icon-row__circle" aria-hidden="true">
                  <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H4.5A1.5 1.5 0 013 19.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/></svg>
                </div>
                <div class="vela-icon-row__divider" aria-hidden="true"></div>
                <div class="vela-icon-row__content">
                  <h3>¿Qué recibe el cliente?</h3>
                  <p>La biografía lista para leer y compartir en familia, junto con un sobre de regalo con sello de lacre que convierte la entrega en un momento inolvidable.</p>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- SECCIÓN 2: EL PRODUCTO Y EL RESULTADO CON PLIEGOS REALES INCLINADOS -->
    <section class="py-24 sm:py-28 bg-[#F1EBE2] border-b border-vela-linea">
      <div class="max-w-7xl mx-auto px-6 space-y-20">

        <!-- Bloque superior centrado -->
        <div class="text-center max-w-3xl mx-auto space-y-6">
          <h2 class="font-serif text-4xl sm:text-5xl font-normal text-vela-chocolate leading-tight">
            Un recuerdo para leer.<br/>
            <span class="italic text-vela-topo">Un regalo para guardar.</span>
          </h2>
          <p class="text-base sm:text-lg text-vela-chocolate/80 font-light leading-relaxed">
            Una biografía personalizada en formato digital, creada con los recuerdos, fotografías y testimonios de una persona, y presentada con un sobre y una tarjeta QR para entregar en mano.
          </p>
          <div class="pt-2 flex flex-wrap justify-center gap-4">
            <a href="/precios" class="px-7 py-3 bg-[#7D6654] text-white text-xs font-medium uppercase tracking-wider rounded-sm hover:bg-vela-chocolate transition-all shadow-sm">
              Crear mi biografía ↗
            </a>
            <a href="#estilos" class="px-7 py-3 bg-[#F8F6F0] border border-vela-chocolate/25 text-vela-chocolate text-xs font-medium uppercase tracking-wider rounded-sm hover:bg-white transition-all">
              Explorar estilos ↗
            </a>
          </div>
        </div>

        <!-- Bloque inferior: Qué contiene + Pliegos reales inclinados -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center pt-8 border-t border-vela-linea">
          <div class="lg:col-span-6 space-y-6">
            <h3 class="font-serif text-3xl sm:text-4xl font-normal text-vela-chocolate leading-tight">
              Así se transforma una vida<br/>
              <span class="italic text-vela-topo">en una biografía.</span>
            </h3>
            <p class="text-base text-vela-chocolate/80 font-light leading-relaxed">
              VELA convierte el material aportado en una historia organizada por capítulos, con fotografías y recuerdos familiares que se pueden leer con comodidad y guardar en PDF.
            </p>

            <ul class="divide-y divide-vela-linea border-t border-b border-vela-linea text-sm text-vela-chocolate font-medium">
              <li class="py-3.5 flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-vela-burdeos"></span> Portada personalizada
              </li>
              <li class="py-3.5 flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-vela-burdeos"></span> Capítulos sobre momentos y personas
              </li>
              <li class="py-3.5 flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-vela-burdeos"></span> Fotografías y recuerdos familiares
              </li>
              <li class="py-3.5 flex items-center gap-3">
                <span class="w-1.5 h-1.5 rounded-full bg-vela-burdeos"></span> Descarga en PDF y lectura digital
              </li>
            </ul>

            <p class="font-serif italic text-vela-chocolate/80 text-base pt-1">
              Una historia íntima y bien maquetada que permanece siempre accesible.
            </p>
          </div>

          <div class="lg:col-span-6">
            <div class="vela-spread-showcase">
              <div class="vela-spread-sheet vela-spread-sheet--left">
                <img src="/assets/templates/nude_page_08.jpg" alt="Página editorial Capítulo 01 Orígenes - Plantilla Nude" />
              </div>
              <div class="vela-spread-sheet vela-spread-sheet--right">
                <div class="vela-spread-photo-page__head">
                  <h4>Paseos eternos en la Huerta</h4>
                </div>
                <div class="vela-spread-photo-page__photo">
                  <img src="/assets/carmen-family-1200.webp" alt="Recuerdos y sobremesas en familia" />
                </div>
                <span class="vela-spread-photo-page__year">1952</span>
                <p class="vela-spread-photo-page__copy">
                  Las tardes largas alrededor de la mesa, las fotografías pasadas de mano en mano y esas historias compartidas que definen a toda una generación.
                </p>
                <div class="vela-spread-photo-page__foot">
                  <span>VELA</span>
                  <span>12</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- SECCIÓN 3: TRES ESTILOS CON SUS 2 PÁGINAS INTERIORES EN MINIATURA DEBAJO -->
    <section id="estilos" class="py-24 sm:py-28 bg-[#F8F6F0] border-b border-vela-linea">
      <div class="max-w-7xl mx-auto px-6">

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16">
          <div class="max-w-2xl">
            <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-vela-chocolate leading-tight">
              La misma emoción.<br/>
              <span class="italic text-vela-topo">Tres formas de contarla.</span>
            </h2>
            <p class="text-base sm:text-lg text-vela-chocolate/75 font-light leading-relaxed mt-4">
              Cada historia puede maquetarse en un estilo editorial diferente. Eliges el tono visual que mejor representa la personalidad de quien protagoniza la vida.
            </p>
          </div>
          <a href="/precios" class="self-start md:self-auto px-6 py-3 bg-[#7D6654] text-white text-xs font-medium uppercase tracking-wider rounded-sm hover:bg-vela-chocolate transition-all shadow-sm shrink-0">
            Comparar precios ↗
          </a>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

          <!-- ESTILO 1: LETTER -->
          <article class="flex flex-col justify-between space-y-6">
            <div>
              <div class="p-6 bg-[#EFE7DB] rounded-sm border border-vela-linea mb-6">
                <div class="aspect-[3/4] overflow-hidden shadow-md bg-white">
                  <img src="/assets/templates/letter_page_01.jpg" alt="Portada Letter - Carmen Rodríguez Sánchez" class="w-full h-full object-cover" />
                </div>
              </div>
              <h3 class="font-sans text-lg uppercase tracking-[0.22em] text-vela-chocolate font-medium mb-2">Letter</h3>
              <p class="text-sm text-vela-chocolate/80 leading-relaxed font-light mb-5">
                Clásico y cercano, inspirado en las cartas antiguas, el papel con memoria y los recuerdos escritos a mano para quienes más quieres.
              </p>
              <!-- 2 Páginas interiores reales en miniatura -->
              <div class="grid grid-cols-2 gap-3 pt-4 border-t border-vela-linea">
                <div class="aspect-[3/4] overflow-hidden bg-white border border-vela-linea shadow-sm rounded-sm">
                  <img src="/assets/templates/letter_page_03.jpg" alt="Página interior Prólogo - Estilo Letter" class="w-full h-full object-cover" />
                </div>
                <div class="aspect-[3/4] overflow-hidden bg-white border border-vela-linea shadow-sm rounded-sm">
                  <img src="/assets/templates/letter_page_07.jpg" alt="Página interior Capítulo 01 - Estilo Letter" class="w-full h-full object-cover" />
                </div>
              </div>
            </div>
            <a href="ejemplos.html#carmen" class="inline-block text-xs font-medium uppercase tracking-wider text-vela-chocolate border-b border-vela-chocolate/30 pb-1 hover:text-vela-burdeos hover:border-vela-burdeos self-start">
              Ver ejemplo Letter →
            </a>
          </article>

          <!-- ESTILO 2: NOIR -->
          <article class="flex flex-col justify-between space-y-6">
            <div>
              <div class="p-6 bg-[#EFE7DB] rounded-sm border border-vela-linea mb-6">
                <div class="aspect-[3/4] overflow-hidden shadow-md bg-[#1A1A1A]">
                  <img src="/assets/templates/noir_page_01.jpg" alt="Portada Noir - Juan Román Ortiz" class="w-full h-full object-cover" />
                </div>
              </div>
              <h3 class="font-sans text-lg uppercase tracking-[0.22em] text-vela-chocolate font-medium mb-2">Noir</h3>
              <p class="text-sm text-vela-chocolate/80 leading-relaxed font-light mb-5">
                Más gráfico y contemporáneo, con contrastes definidos en negro carbón, tipografía rotunda y una puesta en página de carácter sólido.
              </p>
              <!-- 2 Páginas interiores reales en miniatura -->
              <div class="grid grid-cols-2 gap-3 pt-4 border-t border-vela-linea">
                <div class="aspect-[3/4] overflow-hidden bg-[#1D1C1A] border border-vela-linea shadow-sm rounded-sm">
                  <img src="/assets/templates/noir_page_03.jpg" alt="Página interior Prólogo - Estilo Noir" class="w-full h-full object-cover" />
                </div>
                <div class="aspect-[3/4] overflow-hidden bg-white border border-vela-linea shadow-sm rounded-sm">
                  <img src="/assets/templates/noir_page_05.jpg" alt="Página interior Línea de la vida - Estilo Noir" class="w-full h-full object-cover" />
                </div>
              </div>
            </div>
            <a href="ejemplos.html#juan" class="inline-block text-xs font-medium uppercase tracking-wider text-vela-chocolate border-b border-vela-chocolate/30 pb-1 hover:text-vela-burdeos hover:border-vela-burdeos self-start">
              Ver ejemplo Noir →
            </a>
          </article>

          <!-- ESTILO 3: NUDE -->
          <article class="flex flex-col justify-between space-y-6">
            <div>
              <div class="p-6 bg-[#EFE7DB] rounded-sm border border-vela-linea mb-6">
                <div class="aspect-[3/4] overflow-hidden shadow-md bg-[#EAE7E1]">
                  <img src="/assets/templates/nude_page_01.jpg" alt="Portada Nude - Carlota Medina García" class="w-full h-full object-cover" />
                </div>
              </div>
              <h3 class="font-sans text-lg uppercase tracking-[0.22em] text-vela-chocolate font-medium mb-2">Nude</h3>
              <p class="text-sm text-vela-chocolate/80 leading-relaxed font-light mb-5">
                Sereno, cálido y atemporal, en tonos neutros con márgenes amplios que dejan respirar las fotografías y la intimidad del relato.
              </p>
              <!-- 2 Páginas interiores reales en miniatura -->
              <div class="grid grid-cols-2 gap-3 pt-4 border-t border-vela-linea">
                <div class="aspect-[3/4] overflow-hidden bg-white border border-vela-linea shadow-sm rounded-sm">
                  <img src="/assets/templates/nude_page_04.jpg" alt="Página interior Prólogo - Estilo Nude" class="w-full h-full object-cover" />
                </div>
                <div class="aspect-[3/4] overflow-hidden bg-white border border-vela-linea shadow-sm rounded-sm">
                  <img src="/assets/templates/nude_page_08.jpg" alt="Página interior Capítulo 01 Orígenes - Estilo Nude" class="w-full h-full object-cover" />
                </div>
              </div>
            </div>
            <a href="ejemplos.html#carlota" class="inline-block text-xs font-medium uppercase tracking-wider text-vela-chocolate border-b border-vela-chocolate/30 pb-1 hover:text-vela-burdeos hover:border-vela-burdeos self-start">
              Ver ejemplo Nude →
            </a>
          </article>

        </div>

        <p class="text-center text-xs text-vela-topo mt-12">
          Los tres estilos editoriales están disponibles en todos los planes, listos para lectura digital y descarga en PDF.
        </p>

      </div>
    </section>

    <!-- SECCIÓN 4: LECTURA MULTIDISPOSITIVO (iMac + Tablet + Móvil en CSS) -->
    <section class="py-24 sm:py-28 bg-[#F1EBE2] border-b border-vela-linea">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

          <div class="lg:col-span-5 space-y-6">
            <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-normal text-vela-chocolate leading-tight">
              Tu biografía,<br/>
              siempre contigo.<br/>
              <span class="italic text-vela-topo">En móvil, tablet y ordenador.</span>
            </h2>
            <p class="text-base text-vela-chocolate/80 font-light leading-relaxed">
              La biografía puede leerse con comodidad en cualquier momento y desde cualquier dispositivo. Está pensada para acompañarte en ordenador, tablet o móvil y para compartirla con tu familia.
            </p>

            <div class="vela-icon-rows pt-2">
              <div class="vela-icon-row">
                <div class="vela-icon-row__circle" aria-hidden="true">
                  <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"/></svg>
                </div>
                <div class="vela-icon-row__divider" aria-hidden="true"></div>
                <div class="vela-icon-row__content">
                  <h4>Móvil</h4>
                  <p>Lectura vertical ágil y cómoda allá donde vayas.</p>
                </div>
              </div>

              <div class="vela-icon-row">
                <div class="vela-icon-row__circle" aria-hidden="true">
                  <svg fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5h3m-6.75 2.25h10.5a2.25 2.25 0 002.25-2.25v-15a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 4.5v15a2.25 2.25 0 002.25 2.25z"/></svg>
                </div>
                <div class="vela-icon-row__divider" aria-hidden="true"></div>
                <div class="vela-icon-row__content">
                  <h4>Tablet</h4>
                  <p>Sensación de libro abierto y pliego editorial completo.</p>
                </div>
              </div>

              <div class="vela-icon-row">
                <div class="vela-icon-row__circle" aria-hidden="true">
