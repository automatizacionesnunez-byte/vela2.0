  <!-- FOOTER GLOBAL -->
<script is:inline>
    document.addEventListener('DOMContentLoaded', function () {
      // 1. Datos editoriales de nuestros modelos de biografía reales
      const modelData = {
        letter: {
          cover: 'assets/templates/letter_page_01.jpg',
          alt: 'Portada del modelo Letter de Carmen Rodríguez Sánchez',
          num: '01',
          chapter: 'Orígenes',
          subtitle: 'Una vida llena de pequeñas grandes historias',
          p1: 'Carmen nació en un barrio de artesanos y recuerdos de infancia junto al mar. De su madre aprendió el valor de la constancia y de su padre la pasión por la música y las tertulias familiares.',
          p2: 'Su historia avanza como una carta íntima escrita a mano, donde cada fotografía y cada anécdota conservan el perfume y la calidez del hogar.',
          footer: '— Memoria familiar VELA · Modelo Letter —'
        },
        noir: {
          cover: 'assets/templates/noir_page_01.jpg',
          alt: 'Portada del modelo Noir de Juan Román',
          theme: 'is-noir',
          num: '01',
          chapter: 'Infancia',
          subtitle: 'El compañero de camino',
          p1: 'Juan creció en un pueblo donde la palabra dada valía más que cualquier firma. Trabajó desde muy joven en los talleres y construyó una reputación basada en la integridad y el esfuerzo.',
          p2: 'Su legado destaca por un diseño tipográfico sobrio, contrastado y rotundo, donde los momentos clave de su trayectoria adquieren un peso visual inconfundible.',
          footer: '— Colección Noir VELA · Modelo Noir —'
        },
        nude: {
          cover: 'assets/templates/nude_cover_warm.jpg',
          alt: 'Portada del modelo Nude de Carlota Medina García',
          theme: 'is-nude',
          num: '01',
          chapter: 'Orígenes',
          subtitle: 'Una familia entre dos mundos',
          p1: 'Carlota nació en Valencia el 18 de mayo de 1946, en una ciudad que trataba de recuperar la normalidad. Su familia no tenía grandes recursos, pero sí una red de afectos que daba sentido al día a día.',
          p2: 'Sus raíces se repartían entre Russafa y l’Horta. De ambas heredó la constancia de quienes trabajan con las manos y la generosidad de quienes sostienen el hogar entre todos.',
          footer: '— La familia, el mayor tesoro · Modelo Nude —'
        }
      };

      // Selector de modelos en el Hero
      const modelBtns = document.querySelectorAll('.vela-stage-model-btn');
      const bookletImg = document.getElementById('stageBookletImg');
      const ipadScreen = document.getElementById('stageIpadScreen');
      const ipadNum = document.getElementById('stageIpadNum');
      const ipadChapter = document.getElementById('stageIpadChapter');
      const ipadSubtitle = document.getElementById('stageIpadSubtitle');
      const ipadP1 = document.getElementById('stageIpadP1');
      const ipadP2 = document.getElementById('stageIpadP2');
      const ipadFooter = document.getElementById('stageIpadFooter');

      modelBtns.forEach(btn => {
        btn.addEventListener('click', function () {
          modelBtns.forEach(b => {
            b.classList.remove('is-active');
            b.setAttribute('aria-selected', 'false');
          });
          this.classList.add('is-active');
          this.setAttribute('aria-selected', 'true');

          const key = this.dataset.stageModel;
          const data = modelData[key];
          if (!data) return;

          if (bookletImg) {
            bookletImg.style.opacity = '0';
            setTimeout(() => {
              bookletImg.src = data.cover;
              bookletImg.alt = data.alt;
              bookletImg.style.opacity = '1';
            }, 180);
          }

          if (ipadScreen) {
            ipadScreen.classList.remove('is-noir', 'is-nude');
            if (data.theme) ipadScreen.classList.add(data.theme);
          }

          if (ipadNum) ipadNum.textContent = data.num;
          if (ipadChapter) ipadChapter.textContent = data.chapter;
          if (ipadSubtitle) ipadSubtitle.textContent = data.subtitle;
          if (ipadP1) ipadP1.textContent = data.p1;
          if (ipadP2) ipadP2.textContent = data.p2;
          if (ipadFooter) ipadFooter.textContent = data.footer;
        });
      });

      // 2. Alternancia del Sobre real con Lacre (Cerrado vs Abierto)
      const envelopeImg = document.getElementById('velaRealEnvelopeImg');
      const envelopeToggle = document.getElementById('velaStageEnvelopeToggle');
      const envelopeLabel = document.getElementById('velaStageEnvelopeLabel');
      const envelopeContainer = document.getElementById('velaRealEnvelopeContainer');

      let isClosed = true;
      function toggleEnvelope() {
        if (!envelopeImg) return;
        envelopeImg.style.opacity = '0';
        setTimeout(() => {
          if (isClosed) {
            envelopeImg.src = 'assets/sobre-lacre-abierto-transparente.webp';
            envelopeImg.alt = 'Sobre VELA abierto con sello de lacre rojo y dedicatoria personalizada con código QR';
            if (envelopeLabel) envelopeLabel.textContent = 'Ver sobre cerrado';
            isClosed = false;
          } else {
            envelopeImg.src = 'assets/sobre-lacre-cerrado-transparente.webp';
            envelopeImg.alt = 'Sobre VELA cerrado con sello de lacre rojo burdeos y tarjeta con código QR';
            if (envelopeLabel) envelopeLabel.textContent = 'Ver sobre abierto';
            isClosed = true;
          }
          envelopeImg.style.opacity = '1';
        }, 160);
      }

      if (envelopeToggle) envelopeToggle.addEventListener('click', toggleEnvelope);
      if (envelopeContainer) envelopeContainer.addEventListener('click', toggleEnvelope);
    });
  </script>
</BaseLayout>
