<script>
  (function initModal() {
    var modal = document.getElementById('vela-zoom-modal');
    var btnOpen = document.getElementById('btn-open-zoom-modal');
    var btnClose = document.getElementById('btn-close-zoom-modal');
    var btnPrev = document.getElementById('modal-prev');
    var btnNext = document.getElementById('modal-next');
    var imgLeft = document.getElementById('modal-img-left');
    var imgRight = document.getElementById('modal-img-right');
    var tplLabel = document.getElementById('modal-template-label');
    var chapLabel = document.getElementById('modal-chapter-label');

    var currentTemplate = 'nude';
    var currentChapter = 0;

    function updateModal() {
      var pLeft = document.querySelector('[data-vela-gallery-page-left]');
      var pRight = document.querySelector('[data-vela-gallery-page-right]');
      var counterEl = document.querySelector('[data-vela-chapter-counter]');
      if (pLeft && imgLeft) imgLeft.src = pLeft.src;
      if (pRight && imgRight) imgRight.src = pRight.src;
      if (tplLabel) tplLabel.textContent = 'Edición ' + currentTemplate.toUpperCase();
      if (chapLabel) {
        chapLabel.textContent = counterEl ? counterEl.textContent : ('Pliego ' + String(currentChapter + 1).padStart(2, '0'));
      }
    }

    window.addEventListener('vela-reader-open', function(e) {
      if (e.detail) {
        currentTemplate = e.detail.template || currentTemplate;
        currentChapter = e.detail.chapter || 0;
      }
      updateModal();
    });

    window.addEventListener('vela-template-select', function(e) {
      if (e.detail && e.detail.template) {
        currentTemplate = e.detail.template;
        currentChapter = 0;
      }
      updateModal();
    });

    window.addEventListener('vela-chapter-change', function(e) {
      if (e.detail) {
        currentTemplate = e.detail.template || currentTemplate;
        currentChapter = e.detail.chapter;
      }
      updateModal();
    });

    if (btnOpen) {
      btnOpen.addEventListener('click', function() {
        updateModal();
        if (modal) modal.classList.remove('hidden');
      });
    }

    if (btnClose) {
      btnClose.addEventListener('click', function() {
        if (modal) modal.classList.add('hidden');
      });
    }

    if (btnPrev) {
      btnPrev.addEventListener('click', function() {
        if (window.VelaArchive3D && typeof window.VelaArchive3D.setChapter === 'function') {
          window.VelaArchive3D.setChapter(currentTemplate, currentChapter - 1, -1);
        }
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', function() {
        if (window.VelaArchive3D && typeof window.VelaArchive3D.setChapter === 'function') {
          window.VelaArchive3D.setChapter(currentTemplate, currentChapter + 1, 1);
        }
      });
    }

    window.addEventListener('keydown', function(e) {
      if (!modal || modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') modal.classList.add('hidden');
      if (e.key === 'ArrowLeft' && btnPrev) btnPrev.click();
      if (e.key === 'ArrowRight' && btnNext) btnNext.click();
    });
  })();
</script>
</BaseLayout>
