            if (isMobileView()) {
              var mLen = singlePages[key].length;
              stateMobile[key] = (stateMobile[key] - 1 + mLen) % mLen;
            } else {
              var dLen = spreads[key].length;
              stateDesktop[key] = (stateDesktop[key] - 1 + dLen) % dLen;
